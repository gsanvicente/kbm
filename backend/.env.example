# Server
APP_ENV=local
HTTP_PORT=8080

# Database (matches docker-compose.yml local Postgres). Connects as
# kbm_app, not kbm — kbm is a superuser (bootstrapped by POSTGRES_USER,
# owns every table) and would silently bypass every Row-Level Security
# policy, ver docs/adr/0014-row-level-security-policies.md. Migrations
# still run as kbm (docker's init mechanism always uses POSTGRES_USER);
# only the running API/worker processes use this URL.
DATABASE_URL=postgres://kbm_app:kbm_app_dev_only@localhost:5432/kbm?sslmode=disable

# Auth (local stub only — do not use in staging/prod)
JWT_SECRET=changeme-local-only

# Webhook de depósito SPEI entrante — ver
# docs/adr/0021-conector-spei.md. Compartido con el simulador
# (internal/adapters/spei); un proveedor real traería su propio esquema
# de firma en vez de este secreto plano.
SPEI_WEBHOOK_SECRET=changeme-local-only

# AWS (populated only when APP_ENV=aws; leave blank locally)
AWS_REGION=
COGNITO_USER_POOL_ID_STAFF=
COGNITO_USER_POOL_ID_CARDHOLDER=
SQS_QUEUE_URL=
