<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para debug (ver src/debug/AndroidManifest.xml, nunca se mergea en
  release) — permite HTTP sin cifrar hacia el backend Go interino de
  desarrollo (ADR-0010), que todavía no tiene TLS. 10.0.2.2 es cómo el
  emulador de Android alcanza el loopback de la máquina host, no una
  excepción a docs/security/threat-model.md punto 15 (el backend sigue
  escuchando solo en 127.0.0.1). Ver "Probar en mobile" en README.md.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
